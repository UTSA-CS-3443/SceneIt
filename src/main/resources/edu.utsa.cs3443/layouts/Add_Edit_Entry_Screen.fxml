<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.sceneit.controller.AddEditEntryController">
   <children>
      <Label fx:id="formTitleLabel" text="Add Entry">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <HBox prefHeight="51.0" prefWidth="500.0">
         <children>
            <VBox prefHeight="51.0" prefWidth="227.0" spacing="5.0">
               <children>
                  <Label text="Type" />
                  <ComboBox fx:id="typeComboBox" prefHeight="25.0" prefWidth="146.0" promptText="Select Media Type">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </ComboBox>
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" />
            <VBox prefHeight="101.0" prefWidth="173.0" spacing="5.0">
               <children>
                  <Label text="Status" />
                  <ComboBox fx:id="statusComboBox" onAction="#handleStatusChange" promptText="Select Status">
                     <VBox.margin>
                        <Insets right="5.0" />
                     </VBox.margin>
                  </ComboBox>
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox prefHeight="52.0" prefWidth="500.0">
         <children>
            <VBox prefHeight="55.0" prefWidth="500.0">
               <children>
                  <Label text="Title" />
                  <TextField fx:id="titleField" prefHeight="25.0" prefWidth="188.0" promptText="Enter Movie or Show Title" />
               </children>
            </VBox>
            <HBox prefHeight="17.0" prefWidth="430.0">
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label text="Genre" />
                        <TextField fx:id="genreTextField">
                           <VBox.margin>
                              <Insets right="10.0" />
                           </VBox.margin>
                        </TextField>
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label text="Year" />
                              <TextField fx:id="yearField">
                                 <VBox.margin>
                                    <Insets right="10.0" />
                                 </VBox.margin>
                              </TextField>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox fx:id="ratingBox">
                     <children>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label text="Rating" />
                              <TextField fx:id="ratingField" prefHeight="25.0" prefWidth="100.0">
                                 <VBox.margin>
                                    <Insets right="10.0" />
                                 </VBox.margin>
                              </TextField>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox spacing="5.0">
         <children>
            <Label text="Notes" />
            <TextArea fx:id="notesTextArea" prefRowCount="2" promptText="Your notes (optional)" wrapText="true" />
         </children>
      </VBox>
      <VBox fx:id="sceneItTextAreaBox">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="SceneIt" />
                  <TextArea fx:id="sceneTextArea" prefHeight="170.0" prefWidth="500.0" promptText="Describe your favorite scene!" />
               </children>
            </VBox>
         </children>
      </VBox>
      <HBox prefHeight="32.0" prefWidth="500.0">
         <children>
            <DatePicker fx:id="datePicker" />
            <VBox prefHeight="100.0" prefWidth="143.0" />
            <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="25.0" prefWidth="92.0" text="Save">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="25.0" prefWidth="93.0" text="Cancel">
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
</VBox>
